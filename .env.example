# Environment variables
SECRET_KEY=django-insecure-<CHANGE_ME_IN_PRODUCTION>
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://yourdomain.com
ADMIN_URL=admin/
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database
# SQLite (dev): DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (prod): DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# HTTPS (enable in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Social links
FACEBOOK_URL=
INSTAGRAM_URL=
YOUTUBE_URL=
