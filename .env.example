DEBUG=False
SECRET_KEY=your-secret-key-here
DATABASE_URL=postgresql://user:password@127.0.0.1:5433/dbname
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,http://localhost:8000,http://127.0.0.1:8000
MEDIA_ROOT=/app/gallery  # Docker path; adjust for local dev
STATIC_ROOT=/app/staticfiles  # Docker path; adjust for local dev
ADMIN_URL=change-me-admin/  # CHANGE THIS to a random string in production!

# ⚠ SECURITY: For production, you MUST set these in Coolify UI or .env:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# ADMIN_URL=<random-string>/

# Email notifications for the contact form (all optional).
# Leave EMAIL_HOST unset and enquiries are still saved to the admin, just no email.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Kapadia High School <website@kapadiahighschool.com>
# Who receives new enquiries. Blank disables notifications.
CONTACT_NOTIFY_EMAIL=info@kapadiahighschool.com
