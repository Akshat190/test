---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/blocks/PageHero.astro';
import { getGalleries, getImageUrl } from '../lib/api';

const { results: allGalleries } = await getGalleries();
const categories = ['all', ...new Set(allGalleries.map((g) => g.category))];
---

<BaseLayout title="Gallery" canonical="/gallery">
  <PageHero title="Photo Gallery" subtitle="Glimpses of our vibrant school life" />

  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {categories.length > 1 && (
        <div class="flex flex-wrap gap-3 justify-center mb-12">
          {categories.map((cat) => (
            <button
              class="filter-btn px-5 py-2 rounded-full text-sm font-medium transition-all duration-200"
              class:bg-gold-500={cat === 'all'}
              class:bg-gray-100={cat !== 'all'}
              class:text-navy-700={cat === 'all'}
              class:text-gray-600={cat !== 'all'}
              class:hover:bg-gold-400={cat !== 'all'}
              class:hover:text-navy-700={cat !== 'all'}
              data-category={cat}
            >
              {cat === 'all' ? 'All' : cat.charAt(0).toUpperCase() + cat.slice(1)}
            </button>
          ))}
        </div>
      )}

      <div id="gallery-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allGalleries.map((gallery) => (
          <a
            href={`/gallery/${gallery.id}`}
            class="gallery-item group block"
            data-category={gallery.category}
          >
            <div class="bg-white rounded-2xl overflow-hidden shadow-soft hover:shadow-hover transition-all duration-300 hover:-translate-y-1">
              <div class="relative aspect-[4/3] overflow-hidden">
                <img
                  src={getImageUrl(gallery.thumbnail_url) || '/placeholder.jpg'}
                  alt={gallery.name}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-900/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
                <div class="absolute bottom-4 left-4 right-4 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                  <span class="text-xs uppercase tracking-wider text-gold-500 font-semibold">{gallery.category}</span>
                  <h3 class="text-lg font-heading font-semibold text-white">{gallery.name}</h3>
                  <p class="text-sm text-white/80">{gallery.image_count} images</p>
                </div>
              </div>
              <div class="p-4">
                <span class="text-xs uppercase tracking-wider text-gold-600 font-semibold">{gallery.category}</span>
                <h3 class="text-lg font-heading font-semibold text-navy-600 mt-1">{gallery.name}</h3>
                <p class="text-sm text-gray-500 mt-1">{gallery.image_count} images</p>
              </div>
            </div>
          </a>
        ))}
      </div>

      {allGalleries.length === 0 && (
        <div class="text-center py-16">
          <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <h3 class="text-xl font-heading font-semibold text-gray-500">No galleries yet</h3>
          <p class="text-gray-400 mt-2">Check back soon for new photos!</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.gallery-item');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = (btn as HTMLElement).dataset.category;

        buttons.forEach((b) => {
          b.className = `filter-btn px-5 py-2 rounded-full text-sm font-medium transition-all duration-200 ${b === btn ? 'bg-gold-500 text-navy-700' : 'bg-gray-100 text-gray-600 hover:bg-gold-400 hover:text-navy-700'}`;
        });

        items.forEach((item) => {
          if (category === 'all' || (item as HTMLElement).dataset.category === category) {
            (item as HTMLElement).style.display = 'block';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>
