---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/blocks/PageHero.astro';
import { getGalleries, getImageUrl } from '../lib/api';

const { results: allGalleries } = await getGalleries();
const categories = ['all', ...new Set(allGalleries.map((g) => g.category))];
---

<BaseLayout title="Gallery" canonical="/gallery">
  <PageHero title="Photo Gallery" subtitle="Glimpses of our vibrant school life" />

  <section class="hallmark-section paper-light">
    <div class="hallmark-container">
      {categories.length > 1 && (
        <div class="flex flex-wrap gap-3 justify-center mb-12" id="gallery-filters">
          {categories.map((cat) => (
            <button
              class="gallery-filter px-5 py-2 rounded-full text-sm font-semibold transition-colors duration-[var(--dur-fast)] focus-visible:outline-2 focus-visible:outline-[var(--color-accent)]"
              class:bg-[var(--color-accent)]={cat === 'all'}
              class:bg-[var(--color-paper-surface)]={cat !== 'all'}
              class:text-[var(--color-paper)]={cat === 'all'}
              class:text-[var(--color-ink-2)]={cat !== 'all'}
              data-category={cat}
            >
              {cat === 'all' ? 'All' : cat.charAt(0).toUpperCase() + cat.slice(1)}
            </button>
          ))}
        </div>
      )}

      <div id="gallery-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allGalleries.map((gallery) => (
          <a
            href={`/gallery/${gallery.id}`}
            class="gallery-item group block"
            data-category={gallery.category}
          >
            <div class="bg-[var(--color-paper-raised)] rounded-xl overflow-hidden shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-[transform,box-shadow] duration-[var(--dur-base)]">
              <div class="relative aspect-[4/3] overflow-hidden bg-[var(--color-paper-surface-2)]">
                <img
                  src={getImageUrl(gallery.thumbnail_url) || '/placeholder.jpg'}
                  alt={gallery.name}
                  class="w-full h-full object-cover transition-transform duration-[var(--dur-slow)] group-hover:scale-[1.03]"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-paper-4)]/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-[var(--dur-base)]" />
                <div class="absolute bottom-4 left-4 right-4 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-[transform,opacity] duration-[var(--dur-base)]">
                  <span class="text-xs uppercase tracking-[var(--tracking-wide)] text-[var(--color-accent-3)] font-semibold">{gallery.category}</span>
                  <h3 class="font-[var(--font-display)] text-lg font-semibold text-[var(--color-ink-on-paper)]">{gallery.name}</h3>
                  <p class="text-sm text-[var(--color-ink-on-paper-2)]">{gallery.image_count} images</p>
                </div>
              </div>
              <div class="p-4">
                <span class="text-xs uppercase tracking-[var(--tracking-wide)] text-[var(--color-accent-3)] font-semibold">{gallery.category}</span>
                <h3 class="font-[var(--font-display)] text-lg font-semibold text-[var(--color-paper)] mt-1">{gallery.name}</h3>
                <p class="text-sm text-[var(--color-ink-muted)] mt-1">{gallery.image_count} images</p>
              </div>
            </div>
          </a>
        ))}
      </div>

      {allGalleries.length === 0 && (
        <div class="text-center py-16">
          <svg class="w-16 h-16 text-[var(--color-ink-muted)] mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
            <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <h3 class="font-[var(--font-display)] text-xl font-semibold text-[var(--color-ink-muted)]">No galleries yet</h3>
          <p class="text-[var(--color-ink-muted)] mt-2">Check back soon for new photos!</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.gallery-filter');
    const items = document.querySelectorAll('.gallery-item');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.dataset.category;

        buttons.forEach((b) => {
          b.className = `gallery-filter px-5 py-2 rounded-full text-sm font-semibold transition-colors duration-[var(--dur-fast)] focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] ${b === btn ? 'bg-[var(--color-accent)] text-[var(--color-paper)]' : 'bg-[var(--color-paper-surface)] text-[var(--color-ink-2)]'}`;
        });

        items.forEach((item) => {
          if (category === 'all' || item.dataset.category === category) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>
