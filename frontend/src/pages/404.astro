---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page Not Found" canonical="/404">
  <section class="hallmark-section paper-light">
    <div class="hallmark-container" style="min-height: 60vh;">
      <div class="flex items-center justify-center py-24">
        <div class="text-center max-w-lg mx-auto">
          <div class="font-[var(--font-display)] font-semibold text-[var(--color-accent)] mb-4" style="font-size: clamp(4rem, 10vw, 8rem); line-height: 1;">404</div>
          <h1 class="font-[var(--font-display)] text-[var(--text-3xl)] font-semibold text-[var(--color-paper)] mb-4">Page Not Found</h1>
          <p class="text-[var(--color-ink-muted)] mb-8 leading-relaxed">
            The page you're looking for doesn't exist or has been moved. Let's get you back on track.
          </p>
          <Button variant="primary" href="/">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Back to Home
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
