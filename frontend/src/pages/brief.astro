---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/blocks/PageHero.astro';
---

<BaseLayout title="Executive Brief" canonical="/brief">
  <PageHero title="Executive Brief" />

  <section class="hallmark-section paper-light">
    <div class="hallmark-container" style="max-width: 56rem; margin-left: auto; margin-right: auto;">
      <p class="font-[var(--font-display)] text-[var(--text-xl)] font-semibold text-[var(--color-paper)] mb-6 leading-relaxed">
        Kapadia High School: A Legacy of Excellence in Education Since 1956
      </p>

      <p class="text-[var(--color-ink-2)] leading-relaxed mb-6">
        Founded in 1956, Kapadia High School has established itself as a premier educational institution in Gujarat. With a rich history spanning over six decades, we have consistently delivered quality education that nurtures academic excellence, character development, and holistic growth.
      </p>

      <div class="grid md:grid-cols-2 gap-8 mt-12 mb-12">
        <div class="p-8 bg-[var(--color-paper-raised)] rounded-xl shadow-md border-t-[var(--rule-thick)] border-[var(--color-accent)]">
          <h2 class="font-[var(--font-display)] text-[var(--text-2xl)] font-bold text-[var(--color-paper)] mb-4">Our Mission</h2>
          <p class="text-[var(--color-ink-2)] leading-relaxed">To provide a nurturing environment that fosters intellectual curiosity, critical thinking, and moral values, preparing students to become responsible global citizens.</p>
        </div>
        <div class="p-8 bg-[var(--color-paper-raised)] rounded-xl shadow-md border-t-[var(--rule-thick)] border-[var(--color-accent)]">
          <h2 class="font-[var(--font-display)] text-[var(--text-2xl)] font-bold text-[var(--color-paper)] mb-4">Our Vision</h2>
          <p class="text-[var(--color-ink-2)] leading-relaxed">To be a leading educational institution that sets benchmarks in academic excellence, character building, and community engagement.</p>
        </div>
      </div>

      <h2 class="font-[var(--font-display)] text-[var(--text-2xl)] font-bold text-[var(--color-paper)] mt-16 mb-6">Key Highlights</h2>

      <div class="space-y-3 mb-12">
        {["5 campuses across Gujarat serving K-12 students", "Comprehensive curriculum: Science, Commerce & Humanities streams", "Both CBSE and GSEB boards available", "Modern infrastructure with excellent facilities", "Dedicated and experienced faculty"].map((item) => (
          <div class="flex items-start gap-3 p-4 bg-[var(--color-paper-surface)] rounded-xl">
            <svg class="w-5 h-5 text-[var(--color-accent-3)] mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-[var(--color-ink-2)]">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
