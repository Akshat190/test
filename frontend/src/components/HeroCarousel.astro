---
import { getCarouselImages, getImageUrl } from '../lib/api';

const { results: slides } = await getCarouselImages();

const defaultSlides = [
  {
    title: 'Excellence in Education Since 1956',
    subtitle: 'Nurturing young minds to become tomorrow\'s leaders through holistic education and values.',
    image: null,
    get_image_url: null,
    button_text: 'Explore More',
    button_link: '/about',
  },
  {
    title: 'Shaping Bright Futures',
    subtitle: 'State-of-the-art facilities, experienced faculty, and a nurturing environment for every student.',
    image: null,
    get_image_url: null,
    button_text: 'Our Facilities',
    button_link: '/facilities',
  },
  {
    title: 'Join Kapadia High School',
    subtitle: 'Admissions open for K-12. Science, Commerce & Humanities streams available.',
    image: null,
    get_image_url: null,
    button_text: 'Apply Now',
    button_link: 'https://forms.gle/sDftg7osPaxvGKAD8',
  },
];

const items = slides.length > 0 ? slides : defaultSlides;
const slideCount = items.length;
---

{
  slideCount > 0 && (
    <div class="relative overflow-hidden bg-navy-800" x-data="{ current: 0 }">
      <!-- Slides -->
      <div class="relative h-[50vh] md:h-[65vh] lg:h-[75vh]">
        {items.map((slide, i) => {
          const bgImage = slide.get_image_url
            ? `url(${slide.get_image_url})`
            : `url('/placeholder.jpg')`;
          return (
            <div
              class="absolute inset-0 transition-opacity duration-700 ease-in-out"
              class:opacity-0={i !== 0}
              class:opacity-100={i === 0}
              data-slide={i}
            >
              <div
                class="absolute inset-0 bg-cover bg-center"
                style={`background-image: ${bgImage};`}
              />
              <div class="absolute inset-0 bg-gradient-to-r from-navy-900/80 via-navy-900/50 to-transparent" />
              <div class="relative h-full flex items-center max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="max-w-2xl">
                  <h1 class="text-3xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight mb-4 text-balance">
                    {slide.title}
                  </h1>
                  <p class="text-base md:text-lg text-gray-200/90 mb-8 leading-relaxed">
                    {slide.subtitle}
                  </p>
                  <a
                    href={slide.button_link}
                    target={slide.button_link.startsWith('http') ? '_blank' : '_self'}
                    class="inline-flex items-center gap-2 px-8 py-3.5 bg-gold-500 text-navy-500 font-semibold rounded-full hover:bg-white transition-all duration-300 shadow-xl hover:shadow-2xl hover:-translate-y-0.5 text-sm uppercase tracking-wider"
                  >
                    {slide.button_text}
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Navigation dots -->
      {slideCount > 1 && (
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-2 z-10">
          {items.map((_, i) => (
            <button
              class="w-3 h-3 rounded-full transition-all duration-300"
              class:bg-white={i === 0}
              class:bg-white/40={i !== 0}
              class:scale-100={i === 0}
              class:scale-90={i !== 0}
              data-dot={i}
              aria-label={`Slide ${i + 1}`}
            />
          ))}
        </div>
      )}

      <!-- Prev/Next -->
      {slideCount > 1 && (
        <>
          <button
            class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center rounded-full bg-white/10 backdrop-blur-sm text-white hover:bg-white/20 transition-all z-10"
            id="carousel-prev"
            aria-label="Previous slide"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center rounded-full bg-white/10 backdrop-blur-sm text-white hover:bg-white/20 transition-all z-10"
            id="carousel-next"
            aria-label="Next slide"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </>
      )}
    </div>
  )
}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('[data-slide]');
    const dots = document.querySelectorAll('[data-dot]');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    if (!slides.length || slides.length <= 1) return;

    let current = 0;
    const interval = setInterval(nextSlide, 5000);

    function goTo(index) {
      slides.forEach((slide, i) => {
        slide.style.opacity = i === index ? '1' : '0';
      });
      dots.forEach((dot, i) => {
        dot.className = `w-3 h-3 rounded-full transition-all duration-300 ${i === index ? 'bg-white scale-100' : 'bg-white/40 scale-90'}`;
      });
      current = index;
    }

    function nextSlide() {
      goTo((current + 1) % slides.length);
    }

    function prevSlide() {
      goTo((current - 1 + slides.length) % slides.length);
    }

    nextBtn?.addEventListener('click', () => { clearInterval(interval); nextSlide(); });
    prevBtn?.addEventListener('click', () => { clearInterval(interval); prevSlide(); });
    dots.forEach((dot) => {
      dot.addEventListener('click', () => { clearInterval(interval); goTo(Number(dot.dataset.dot)); });
    });
  });
</script>
