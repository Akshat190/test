---
import { getCarouselImages, getImageUrl } from '../lib/api';
import Button from './ui/Button.astro';

const { results: slides } = await getCarouselImages();

const defaultSlides = [
  {
    title: 'Excellence in Education Since 1956',
    subtitle: 'Nurturing young minds to become tomorrow\'s leaders through holistic education and values.',
    image: null,
    get_image_url: null,
    button_text: 'Explore More',
    button_link: '/about',
  },
  {
    title: 'Shaping Bright Futures',
    subtitle: 'State-of-the-art facilities, experienced faculty, and a nurturing environment for every student.',
    image: null,
    get_image_url: null,
    button_text: 'Our Facilities',
    button_link: '/facilities',
  },
  {
    title: 'Join Kapadia High School',
    subtitle: 'Admissions open for K-12. Science, Commerce & Humanities streams available.',
    image: null,
    get_image_url: null,
    button_text: 'Apply Now',
    button_link: 'https://forms.gle/sDftg7osPaxvGKAD8',
  },
];

const items = slides.length > 0 ? slides : defaultSlides;
const slideCount = items.length;
---

{
  slideCount > 0 && (
    <section class="relative overflow-hidden bg-[var(--color-paper-4)]" aria-label="Featured highlights">
      <div class="relative" style="height: clamp(50vh, 65vh, 75vh);">
        {items.map((slide, i) => {
          const bgImage = slide.get_image_url
            ? `url(${slide.get_image_url})`
            : `url('/placeholder.jpg')`;
          return (
            <div
              class="absolute inset-0 transition-opacity duration-[var(--dur-reveal)] ease-[var(--ease-out)]"
              class:opacity-0={i !== 0}
              class:opacity-100={i === 0}
              data-slide={i}
              aria-hidden={i !== 0}
            >
              <div
                class="absolute inset-0 bg-cover bg-center"
                style={`background-image: ${bgImage};`}
              />
              <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-paper-4)]/85 via-[var(--color-paper-4)]/50 to-transparent" />
              <div class="relative h-full flex items-center hallmark-container">
                <div class="max-w-2xl">
                  <h1 class="font-[var(--font-display)] font-semibold text-[var(--color-ink-on-paper)] leading-[var(--leading-display)] mb-4 text-balance overflow-wrap-anywhere"
                      style="font-size: clamp(2rem, 5vw, var(--text-display));">
                    {slide.title}
                  </h1>
                  <p class="text-base md:text-lg text-[var(--color-ink-on-paper-2)] mb-8 leading-relaxed max-w-xl">
                    {slide.subtitle}
                  </p>
                  <Button
                    variant="primary"
                    href={slide.button_link}
                    target={slide.button_link.startsWith('http') ? '_blank' : '_self'}
                    size="lg"
                  >
                    {slide.button_text}
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </Button>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      {slideCount > 1 && (
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-2 z-10">
          {items.map((_, i) => (
            <button
              class="w-3 h-3 rounded-full transition-[background-color,scale] duration-[var(--dur-base)] focus-visible:outline-2 focus-visible:outline-[var(--color-accent)]"
              class:bg-[var(--color-accent)]={i === 0}
              class:bg-[var(--color-ink-on-paper)]/40={i !== 0}
              class:scale-100={i === 0}
              class:scale-90={i !== 0}
              data-dot={i}
              aria-label={`Slide ${i + 1}`}
            />
          ))}
        </div>
      )}

      {slideCount > 1 && (
        <>
          <button
            class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center rounded-full bg-white/10 backdrop-blur-sm text-[var(--color-ink-on-paper)] hover:bg-white/20 transition-[background-color] duration-[var(--dur-base)] z-10 focus-visible:outline-2 focus-visible:outline-[var(--color-accent)]"
            id="carousel-prev"
            aria-label="Previous slide"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center rounded-full bg-white/10 backdrop-blur-sm text-[var(--color-ink-on-paper)] hover:bg-white/20 transition-[background-color] duration-[var(--dur-base)] z-10 focus-visible:outline-2 focus-visible:outline-[var(--color-accent)]"
            id="carousel-next"
            aria-label="Next slide"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </>
      )}
    </section>
  )
}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('[data-slide]');
    const dots = document.querySelectorAll('[data-dot]');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    if (!slides.length || slides.length <= 1) return;

    let current = 0;
    const interval = setInterval(nextSlide, 5000);

    function goTo(index) {
      slides.forEach((slide, i) => {
        slide.style.opacity = i === index ? '1' : '0';
      });
      dots.forEach((dot, i) => {
        dot.className = `w-3 h-3 rounded-full transition-[background-color,scale] duration-[var(--dur-base)] ${i === index ? 'bg-[var(--color-accent)] scale-100' : 'bg-[var(--color-ink-on-paper)]/40 scale-90'}`;
      });
      current = index;
    }

    function nextSlide() {
      goTo((current + 1) % slides.length);
    }

    function prevSlide() {
      goTo((current - 1 + slides.length) % slides.length);
    }

    nextBtn?.addEventListener('click', () => { clearInterval(interval); nextSlide(); });
    prevBtn?.addEventListener('click', () => { clearInterval(interval); prevSlide(); });
    dots.forEach((dot) => {
      dot.addEventListener('click', () => { clearInterval(interval); goTo(Number(dot.dataset.dot)); });
    });
  });
</script>
