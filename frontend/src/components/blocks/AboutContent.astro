---
import { SITE } from "../../lib/constants";
---

<section class="hallmark-section paper-light">
  <div class="hallmark-container">
    <div class="mx-auto" style="max-width: 56rem;">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center mb-16 md:mb-20">
        <figure class="aspect-[4/3] rounded-xl overflow-hidden shadow-lg bg-[var(--color-paper-surface-2)]">
          <img src="/placeholder.jpg" alt="Kapadia High School" class="w-full h-full object-cover" loading="lazy" />
        </figure>
        <div>
          <h2 class="font-[var(--font-display)] text-[var(--text-3xl)] font-semibold text-[var(--color-paper)]">Our Legacy</h2>
          <div class="h-[var(--rule-base)] bg-[var(--color-accent)] rounded-full my-4" style="width: 2.5rem" />
          <p class="text-[var(--color-ink-2)] leading-relaxed mb-4">
            Kapadia High School was founded in {SITE.founded}, starting with a modest group of students eager to learn. Over the years, our institution has grown into a vibrant educational center, nurturing a diverse array of students who shine brightly both locally and internationally.
          </p>
          <p class="text-[var(--color-ink-2)] leading-relaxed">
            Situated in the heart of the community, Kapadia High School is a co-educational English medium school dedicated to fostering academic excellence and personal growth in a supportive environment.
          </p>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-6 mb-16 md:mb-20">
        {[
          { label: "Academic Excellence", desc: "Comprehensive K-12 curriculum with Science, Commerce & Humanities streams" },
          { label: "Expert Faculty", desc: "Dedicated teachers committed to nurturing every student's potential" },
          { label: "Modern Facilities", desc: "State-of-the-art infrastructure across all five campuses" },
        ].map((item) => (
          <div class="p-6 md:p-8 bg-[var(--color-paper-raised)] rounded-xl shadow-md hover:shadow-lg transition-[box-shadow] duration-[var(--dur-base)]">
            <h3 class="font-[var(--font-display)] text-xl font-semibold text-[var(--color-paper)] mb-2">{item.label}</h3>
            <p class="text-sm text-[var(--color-ink-2)] leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="bg-[var(--color-paper-surface)] rounded-xl p-8 md:p-12">
        <h2 class="font-[var(--font-display)] text-[var(--text-3xl)] font-semibold text-[var(--color-paper)] mb-6 text-center">Our Campuses</h2>
        <div class="grid md:grid-cols-3 gap-4">
          {[
            { name: "Chandkheda", board: "GSEB", slug: "chandkheda" },
            { name: "Chhatral", board: "CBSE", slug: "chattral" },
            { name: "IFFCO Township", board: "CBSE", slug: "iffco" },
            { name: "Kadi", board: "GSEB", slug: "kadi" },
            { name: "Shela", board: "CBSE", slug: "shela" },
          ].map((campus) => (
            <a href={`/campuses/${campus.slug}`} class="block p-5 bg-[var(--color-paper-raised)] rounded-xl shadow-md hover:shadow-lg transition-[box-shadow] duration-[var(--dur-base)]">
              <h3 class="font-[var(--font-display)] text-lg font-semibold text-[var(--color-paper)]">{campus.name}</h3>
              <p class="text-sm text-[var(--color-ink-muted)] mt-1">{campus.board}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
