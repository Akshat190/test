---
import Badge from "../ui/Badge.astro";
import { SITE } from "../../lib/constants";
---

<section class="py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
        <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-xl bg-gray-200">
          <img src="/placeholder.jpg" alt="Kapadia High School" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div>
          <h2 class="text-3xl font-heading font-bold text-navy-500 mb-4">Our Legacy</h2>
          <p class="text-gray-600 mb-4">
            Kapadia High School was founded in {SITE.founded}, starting with a modest group of students eager to learn. Over the years, our institution has grown into a vibrant educational center, nurturing a diverse array of students who shine brightly both locally and internationally.
          </p>
          <p class="text-gray-600">
            Situated in the heart of the community, Kapadia High School is a co-educational English medium school dedicated to fostering academic excellence and personal growth in a supportive environment.
          </p>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mb-16">
        <div class="text-center p-8 bg-white rounded-2xl shadow-soft hover:shadow-hover transition-all duration-300">
          <div class="w-16 h-16 bg-gold-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-semibold text-navy-600 mb-2">Academic Excellence</h3>
          <p class="text-gray-500 text-sm">Comprehensive curriculum from K-12 with Science, Commerce & Humanities streams</p>
        </div>
        <div class="text-center p-8 bg-white rounded-2xl shadow-soft hover:shadow-hover transition-all duration-300">
          <div class="w-16 h-16 bg-gold-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-semibold text-navy-600 mb-2">Expert Faculty</h3>
          <p class="text-gray-500 text-sm">Dedicated teachers committed to nurturing every student's potential</p>
        </div>
        <div class="text-center p-8 bg-white rounded-2xl shadow-soft hover:shadow-hover transition-all duration-300">
          <div class="w-16 h-16 bg-gold-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-semibold text-navy-600 mb-2">Modern Facilities</h3>
          <p class="text-gray-500 text-sm">State-of-the-art infrastructure across all five campuses</p>
        </div>
      </div>

      <div class="bg-navy-50 rounded-2xl p-8 md:p-12">
        <h2 class="text-3xl font-heading font-bold text-navy-500 mb-6 text-center">Our Campuses</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {[
            { name: "Chandkheda", board: "GSEB", slug: "chandkheda" },
            { name: "Chhatral", board: "CBSE", slug: "chattral" },
            { name: "IFFCO Township", board: "CBSE", slug: "iffco" },
            { name: "Kadi", board: "GSEB", slug: "kadi" },
            { name: "Shela", board: "CBSE", slug: "shela" },
          ].map((campus) => (
            <a href={`/campuses/${campus.slug}`} class="block p-5 bg-white rounded-xl shadow-soft hover:shadow-hover transition-all duration-300">
              <h3 class="font-heading text-lg font-semibold text-navy-600">{campus.name}</h3>
              <p class="text-sm text-gray-500 mt-1">{campus.board}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
