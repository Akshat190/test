---
import SectionTitle from "../ui/SectionTitle.astro";
import { TEAM_MEMBERS, FACULTY_DEPARTMENTS } from "../../lib/constants";

interface Props {
  showFaculty?: boolean;
}

const { showFaculty = true } = Astro.props;
---

<section class="hallmark-section paper-light">
  <div class="hallmark-container">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-10">
      {TEAM_MEMBERS.map((member) => (
        <div class="text-center">
          <div class="w-36 h-36 mx-auto mb-4 rounded-full bg-[var(--color-paper-surface-2)] flex items-center justify-center overflow-hidden">
            <svg class="w-16 h-16 text-[var(--color-ink-muted)]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="font-[var(--font-display)] text-lg font-semibold text-[var(--color-paper)]">{member.name}</h3>
          <p class="text-xs uppercase tracking-[var(--tracking-wide)] text-[var(--color-accent-3)] font-semibold mt-1">{member.role}</p>
          <p class="text-sm text-[var(--color-ink-muted)] mt-2">{member.desc}</p>
        </div>
      ))}
    </div>

    {showFaculty && (
      <div class="mt-20">
        <SectionTitle title="Our Faculty" subtitle="Our dedicated team of experienced and passionate educators." centered />

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
          {FACULTY_DEPARTMENTS.map((dept) => (
            <div class="p-6 bg-[var(--color-paper-raised)] rounded-xl shadow-md hover:shadow-lg transition-[box-shadow] duration-[var(--dur-base)]">
              <h3 class="font-[var(--font-display)] text-lg font-semibold text-[var(--color-paper)] mb-2">{dept.dept}</h3>
              <p class="text-sm text-[var(--color-ink-2)]">{dept.teachers}</p>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
