---
import type { Campus } from "../../lib/types";
import { getImageUrl } from "../../lib/api";

interface Props {
  campus: Campus;
}

const { campus } = Astro.props;
---

<a href={`/campuses/${campus.slug}`} class="group block">
  <div class="bg-white rounded-2xl overflow-hidden shadow-soft hover:shadow-hover transition-all duration-300 hover:-translate-y-1">
    <div class="relative aspect-[16/10] overflow-hidden bg-gray-100">
      {campus.get_photo_url ? (
        <img src={getImageUrl(campus.get_photo_url)} alt={campus.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center text-gray-400">
          <svg class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
      )}
      <div class="absolute top-4 left-4 bg-gold-500 text-navy-500 text-xs font-semibold px-3 py-1 rounded-full">
        {campus.board}
      </div>
    </div>
    <div class="p-5">
      <h3 class="text-xl font-heading font-semibold text-navy-600 group-hover:text-gold-600 transition-colors">{campus.name}</h3>
      {campus.timings && <p class="text-sm text-gray-500 mt-1">{campus.timings}</p>}
    </div>
  </div>
</a>
