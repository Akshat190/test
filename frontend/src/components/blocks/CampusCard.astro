---
import type { Campus } from "../../lib/types";
import { getImageUrl } from "../../lib/api";

interface Props {
  campus: Campus;
}

const { campus } = Astro.props;
---

<a href={`/campuses/${campus.slug}`} class="group block">
  <article class="bg-[var(--color-paper-raised)] rounded-xl overflow-hidden shadow-md hover:shadow-lg hover:-translate-y-1 transition-[transform,box-shadow] duration-[var(--dur-base)]">
    <div class="relative aspect-[16/10] overflow-hidden bg-[var(--color-paper-surface-2)]">
      {campus.get_photo_url ? (
        <img src={getImageUrl(campus.get_photo_url)} alt={campus.name} class="w-full h-full object-cover transition-transform duration-[var(--dur-slow)] group-hover:scale-[1.03]" loading="lazy" />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center text-[var(--color-ink-muted)]">
          <svg class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
            <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
      )}
      <div class="absolute top-3 left-3 bg-[var(--color-accent)] text-[var(--color-paper)] text-xs font-semibold px-3 py-1 rounded-full">
        {campus.board}
      </div>
    </div>
    <div class="p-5">
      <h3 class="font-[var(--font-display)] text-xl font-semibold text-[var(--color-paper)] group-hover:text-[var(--color-accent)] transition-colors duration-[var(--dur-fast)]">{campus.name}</h3>
      {campus.timings && <p class="text-sm text-[var(--color-ink-muted)] mt-1">{campus.timings}</p>}
    </div>
  </article>
</a>
