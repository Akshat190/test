---
import { cn } from "../../lib/utils";

interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  class?: string;
}

const { title, subtitle, badge, class: className } = Astro.props;
---

<div class={cn("paper-dark bg-[var(--color-paper)] py-16 md:py-28", className)}>
  <div class="hallmark-container">
    {badge && (
      <div class="text-center mb-4">
        <span
          class="inline-block bg-[var(--color-accent)] text-[var(--color-paper)] text-xs font-semibold px-4 py-1.5 rounded-full uppercase tracking-[var(--tracking-wide)]"
          style="letter-spacing: var(--tracking-wide)"
        >
          {badge}
        </span>
      </div>
    )}
    <div class={cn("max-w-4xl", badge ? "text-center mx-auto" : "text-center mx-auto")}>
      <h1
        class="text-[var(--color-ink-on-paper)] overflow-wrap-anywhere"
        style="font-size: var(--text-display-s);"
      >
        {title}
      </h1>
      <div
        class="h-[var(--rule-base)] bg-[var(--color-accent)] rounded-full mx-auto mt-4"
        style="width: 3rem"
      />
      {subtitle && (
        <p class="mt-5 text-base md:text-xl text-[var(--color-ink-on-paper-2)] max-w-2xl mx-auto leading-relaxed">
          {subtitle}
        </p>
      )}
    </div>
  </div>
</div>
