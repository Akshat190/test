---
import { getImageUrl } from "../../lib/api";
import Button from "../ui/Button.astro";
import type { Campus } from "../../lib/types";

interface Props {
  campus: Campus;
}

const { campus } = Astro.props;
---

<section class="hallmark-section paper-light">
  <div class="hallmark-container">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
      <figure class="aspect-[4/3] rounded-xl overflow-hidden shadow-lg bg-[var(--color-paper-surface-2)]">
        {campus.get_photo_url ? (
          <img src={getImageUrl(campus.get_photo_url)} alt={campus.name} class="w-full h-full object-cover" loading="lazy" />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-[var(--color-ink-muted)]">
            <svg class="w-24 h-24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
        )}
      </figure>

      <div>
        <h2 class="font-[var(--font-display)] text-[var(--text-3xl)] font-semibold text-[var(--color-paper)] mb-2">About {campus.name}</h2>
        <div class="h-[var(--rule-base)] bg-[var(--color-accent)] rounded-full mb-6" style="width: 2.5rem" />

        <dl class="space-y-4">
          {campus.board && (
            <div class="flex items-center gap-3 p-4 bg-[var(--color-paper-surface)] rounded-xl">
              <dt class="text-xs uppercase tracking-[var(--tracking-wide)] text-[var(--color-ink-muted)] font-semibold">Board</dt>
              <dd class="text-[var(--color-paper)] font-medium">{campus.board}</dd>
            </div>
          )}
          {campus.affiliation_number && (
            <div class="flex items-center gap-3 p-4 bg-[var(--color-paper-surface)] rounded-xl">
              <dt class="text-xs uppercase tracking-[var(--tracking-wide)] text-[var(--color-ink-muted)] font-semibold">Affiliation No.</dt>
              <dd class="text-[var(--color-paper)] font-medium">{campus.affiliation_number}</dd>
            </div>
          )}
          {campus.timings && (
            <div class="flex items-center gap-3 p-4 bg-[var(--color-paper-surface)] rounded-xl">
              <dt class="text-xs uppercase tracking-[var(--tracking-wide)] text-[var(--color-ink-muted)] font-semibold">Timings</dt>
              <dd class="text-[var(--color-paper)] font-medium">{campus.timings}</dd>
            </div>
          )}
        </dl>

        {campus.documents.length > 0 && (
          <div class="mt-8">
            <h3 class="font-[var(--font-display)] text-xl font-semibold text-[var(--color-paper)] mb-4">Documents</h3>
            <div class="space-y-2">
              {campus.documents.map((doc) => (
                <a
                  href={doc.get_file_url || "#"}
                  target="_blank"
                  rel="noopener"
                  class="flex items-center gap-3 p-3 bg-[var(--color-paper-raised)] border border-[var(--color-border)] rounded-xl hover:border-[var(--color-accent)] hover:shadow-md transition-[border-color,box-shadow] duration-[var(--dur-base)] group"
                >
                  <span class="text-sm text-[var(--color-ink-2)] group-hover:text-[var(--color-paper)] font-medium flex-1">{doc.title}</span>
                  <svg class="w-4 h-4 text-[var(--color-ink-muted)] group-hover:text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>

    <div class="mt-16 text-center">
      <Button variant="outline" href="/campuses">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M15 19l-7-7 7-7" />
        </svg>
        All Campuses
      </Button>
    </div>
  </div>
</section>
