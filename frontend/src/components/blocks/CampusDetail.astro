---
import { getImageUrl } from "../../lib/api";
import Button from "../ui/Button.astro";
import type { Campus } from "../../lib/types";

interface Props {
  campus: Campus;
}

const { campus } = Astro.props;
---

<section class="py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-12">
      <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-xl bg-gray-100">
        {campus.get_photo_url ? (
          <img src={getImageUrl(campus.get_photo_url)} alt={campus.name} class="w-full h-full object-cover" loading="lazy" />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-gray-400">
            <svg class="w-24 h-24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
        )}
      </div>

      <div>
        <h2 class="text-3xl font-heading font-bold text-navy-500 mb-6">About {campus.name}</h2>
        <div class="w-16 h-1 bg-gold-500 rounded-full mb-6" />

        <div class="space-y-4">
          {campus.board && (
            <div class="flex items-center gap-3 p-4 bg-navy-50 rounded-xl">
              <svg class="w-5 h-5 text-gold-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              <div>
                <span class="text-xs text-gray-500 uppercase tracking-wider">Board</span>
                <p class="text-navy-600 font-medium">{campus.board}</p>
              </div>
            </div>
          )}
          {campus.affiliation_number && (
            <div class="flex items-center gap-3 p-4 bg-navy-50 rounded-xl">
              <svg class="w-5 h-5 text-gold-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <div>
                <span class="text-xs text-gray-500 uppercase tracking-wider">Affiliation Number</span>
                <p class="text-navy-600 font-medium">{campus.affiliation_number}</p>
              </div>
            </div>
          )}
          {campus.timings && (
            <div class="flex items-center gap-3 p-4 bg-navy-50 rounded-xl">
              <svg class="w-5 h-5 text-gold-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div>
                <span class="text-xs text-gray-500 uppercase tracking-wider">Timings</span>
                <p class="text-navy-600 font-medium">{campus.timings}</p>
              </div>
            </div>
          )}
        </div>

        {campus.documents.length > 0 && (
          <div class="mt-8">
            <h3 class="text-xl font-heading font-semibold text-navy-600 mb-4">Documents</h3>
            <div class="space-y-2">
              {campus.documents.map((doc) => (
                <a
                  href={doc.get_file_url || '#'}
                  target="_blank"
                  class="flex items-center gap-3 p-3 bg-white border border-gray-200 rounded-xl hover:border-gold-500 hover:shadow-md transition-all group"
                >
                  <svg class="w-5 h-5 text-gold-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                  </svg>
                  <span class="text-sm text-gray-700 group-hover:text-navy-600 font-medium flex-1">{doc.title}</span>
                  <svg class="w-4 h-4 text-gray-400 group-hover:text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>

    <div class="mt-16 text-center">
      <Button variant="outline" href="/campuses">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        All Campuses
      </Button>
    </div>
  </div>
</section>
