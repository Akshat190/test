};
---

<section class="hallmark-section paper-light">
  <div class="hallmark-container">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {FACILITIES.map((facility) => (
        <div class="p-6 md:p-8 bg-[var(--color-paper-raised)] rounded-xl shadow-md hover:shadow-lg hover:-translate-y-1 transition-[transform,box-shadow] duration-[var(--dur-base)] group">
          <div class="w-12 h-12 bg-[var(--color-accent-soft)] rounded-xl flex items-center justify-center mb-4 group-hover:bg-[var(--color-accent)] transition-colors duration-[var(--dur-base)]">
            <svg class="w-6 h-6 text-[var(--color-accent-3)] group-hover:text-[var(--color-paper)] transition-colors duration-[var(--dur-base)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d={iconPaths[facility.icon] || iconPaths.book} />
            </svg>
          </div>
          <h3 class="font-[var(--font-display)] text-xl font-semibold text-[var(--color-paper)] mb-2">{facility.title}</h3>
          <p class="text-sm text-[var(--color-ink-2)] leading-relaxed">{facility.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
