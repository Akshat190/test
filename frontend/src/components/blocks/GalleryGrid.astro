---
import SectionTitle from "../ui/SectionTitle.astro";
import Button from "../ui/Button.astro";
import { getGalleries, getImageUrl } from "../../lib/api";

interface Props {
  limit?: number;
  featured?: boolean;
}

const { limit = 6, featured = false } = Astro.props;
const { results: allGalleries } = await getGalleries(featured);
const display = allGalleries.slice(0, limit);

const fallbackItems = [
  { name: "Academic Excellence", slug: "academic" },
  { name: "Sports Activities", slug: "sports" },
  { name: "Cultural Events", slug: "cultural" },
].slice(0, limit);
---

<section class="hallmark-section paper-raised">
  <div class="hallmark-container">
    <SectionTitle
      title="Our Gallery"
      subtitle="Glimpses of vibrant campus life and student activities"
    />

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {(display.length > 0 ? display : fallbackItems).map((item) => {
        const id = "id" in item ? item.id : null;
        const name = "name" in item ? item.name : (item as any).name;
        const category = "category" in item ? item.category : null;
        const count = "image_count" in item ? item.image_count : null;
        const thumb = "thumbnail_url" in item ? getImageUrl(item.thumbnail_url) : null;
        const href = id ? `/gallery/${id}` : "/gallery";
        return (
          <a href={href} class="group block">
            <article class="bg-[var(--color-paper-surface)] rounded-xl overflow-hidden shadow-md transition-[transform,box-shadow] duration-[var(--dur-base)] hover:shadow-lg hover:-translate-y-1">
              <div class="relative aspect-[4/3] overflow-hidden">
                {thumb ? (
                  <img
                    src={thumb}
                    alt={name}
                    class="w-full h-full object-cover transition-transform duration-[var(--dur-slow)] group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full bg-[var(--color-paper-surface-2)] flex items-center justify-center">
                    <svg class="w-16 h-16 text-[var(--color-ink-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                      <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-paper-4)]/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-[var(--dur-base)]" />
              </div>
              <div class="p-5">
                {category && (
                  <span class="text-xs uppercase tracking-[var(--tracking-wide)] text-[var(--color-accent-3)] font-semibold">
                    {category}
                  </span>
                )}
                <h3 class="font-[var(--font-display)] text-xl font-semibold text-[var(--color-paper)] mt-1 group-hover:text-[var(--color-accent)] transition-colors duration-[var(--dur-fast)]">
                  {name}
                </h3>
                {count !== null && (
                  <p class="text-sm text-[var(--color-ink-muted)] mt-2">{count} images</p>
                )}
              </div>
            </article>
          </a>
        );
      })}
    </div>

    <div class="text-center mt-10 md:mt-14">
      <Button variant="primary" href="/gallery">
        View Full Gallery
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </Button>
    </div>
  </div>
</section>
