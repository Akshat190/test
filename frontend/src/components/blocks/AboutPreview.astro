---
import Button from "../ui/Button.astro";
---

<section class="hallmark-section paper-light">
  <div class="hallmark-container">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <figure class="relative order-2 lg:order-1">
        <div class="aspect-[4/3] rounded-xl overflow-hidden shadow-lg bg-[var(--color-paper-surface-2)]">
          <img
            src="/placeholder.jpg"
            alt="Students at Kapadia High School"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </figure>
      <div class="order-1 lg:order-2">
        <h2 class="font-[var(--font-display)] text-[var(--text-3xl)] font-semibold text-[var(--color-paper)] overflow-wrap-anywhere">
          About Our School
        </h2>
        <div class="h-[var(--rule-base)] bg-[var(--color-accent)] rounded-full mt-3 mb-6" style="width: 3rem" />
        <p class="text-[var(--color-ink-2)] leading-relaxed mb-4">
          Kapadia High School was founded in 1956, starting with a modest group of students eager to learn. Over the years, our institution has grown into a vibrant educational center, nurturing a diverse array of students who shine brightly both locally and internationally.
        </p>
        <p class="text-[var(--color-ink-2)] leading-relaxed mb-8">
          Situated in the heart of the community, Kapadia High School is a co-educational English medium school dedicated to fostering academic excellence and personal growth in a supportive environment.
        </p>
        <Button variant="primary" href="/about">
          Learn More
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </Button>
      </div>
    </div>
  </div>
</section>
