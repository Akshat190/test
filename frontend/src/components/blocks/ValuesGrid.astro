---
import SectionTitle from "../ui/SectionTitle.astro";
import { VALUES } from "../../lib/constants";

const iconPaths: Record<string, string> = {
  book: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
  shield: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  heart: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  zap: "M13 10V3L4 14h7v7l9-11h-7z",
  users: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z",
  home: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
};
---

<section class="hallmark-section paper-light">
  <div class="hallmark-container">
    <SectionTitle title="Our Core Values" centered />

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {VALUES.map((value) => (
        <div class="p-6 md:p-8 bg-[var(--color-paper-raised)] rounded-xl shadow-md hover:shadow-lg hover:-translate-y-1 transition-[transform,box-shadow] duration-[var(--dur-base)] text-center">
          <div class="w-12 h-12 bg-[var(--color-accent-soft)] rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-[var(--color-accent-3)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d={iconPaths[value.icon] || iconPaths.book} />
            </svg>
          </div>
          <h3 class="font-[var(--font-display)] text-xl font-semibold text-[var(--color-paper)] mb-2">{value.title}</h3>
          <p class="text-sm text-[var(--color-ink-2)] leading-relaxed">{value.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
