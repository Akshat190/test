---
import { SUCCESS_STORIES } from "../../lib/constants";
import { getInitials } from "../../lib/utils";
---

<section class="hallmark-section paper-light">
  <div class="hallmark-container">
    <div class="space-y-12 md:space-y-16">
      {SUCCESS_STORIES.map((story, i) => (
        <div class={`grid lg:grid-cols-3 gap-8 md:gap-12 items-center p-8 md:p-10 rounded-xl ${i % 2 === 0 ? 'bg-[var(--color-paper-raised)] shadow-md' : 'bg-[var(--color-paper-surface)]'}`}>
          <div class={i % 2 === 0 ? 'lg:order-1' : 'lg:order-2'}>
            <div class="aspect-square w-44 h-44 mx-auto rounded-full bg-gradient-to-br from-[var(--color-paper-surface-2)] to-[var(--color-accent-soft)] flex items-center justify-center">
              <span class="text-3xl font-[var(--font-display)] font-bold text-[var(--color-paper)]/40">{getInitials(story.name)}</span>
            </div>
          </div>
          <div class={`lg:col-span-2 ${i % 2 === 0 ? 'lg:order-2' : 'lg:order-1'}`}>
            <span class="text-xs uppercase tracking-[var(--tracking-wide)] text-[var(--color-accent-3)] font-semibold">{story.batch}</span>
            <h2 class="font-[var(--font-display)] text-[var(--text-2xl)] font-semibold text-[var(--color-paper)] mt-1">{story.name}</h2>
            <p class="text-sm font-medium text-[var(--color-accent-3)] mb-3">{story.achievement}</p>
            <p class="text-[var(--color-ink-2)] leading-relaxed">{story.story}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
