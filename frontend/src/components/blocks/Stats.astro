---
import { STATS } from "../../lib/constants";

interface Props {
  items?: readonly { number: string; label: string }[];
}

const { items = STATS } = Astro.props;
---

<section class="py-16 bg-gradient-to-r from-navy-500 to-navy-700 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {items.map((stat) => (
        <div class="space-y-2">
          <div class="text-4xl md:text-5xl font-heading font-bold text-gold-500">{stat.number}</div>
          <div class="text-sm uppercase tracking-wider text-white/70">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
