---
import { STATS } from "../../lib/constants";

interface Props {
  items?: readonly { number: string; label: string }[];
}

const { items = STATS } = Astro.props;
---

<section class="paper-dark bg-[var(--color-paper-3)] py-14 md:py-20">
  <div class="hallmark-container">
    <dl class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 text-center">
      {items.map((stat) => (
        <div class="space-y-1">
          <dt class="font-[var(--font-display)] text-[var(--color-accent)] leading-[var(--leading-display)]"
              style="font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 3.75rem); font-weight: 600;">
            {stat.number}
          </dt>
          <dd class="text-xs uppercase tracking-[var(--tracking-wide)] text-[var(--color-ink-on-paper-muted)]"
              style="letter-spacing: var(--tracking-wide);">
            {stat.label}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
