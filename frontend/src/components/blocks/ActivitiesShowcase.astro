---
import { ACTIVITIES_SECTIONS } from "../../lib/constants";
---

<section class="hallmark-section paper-light">
  <div class="hallmark-container">
    <div class="space-y-16 md:space-y-24">
      {ACTIVITIES_SECTIONS.map((section, i) => (
        <div class={`grid md:grid-cols-2 gap-8 md:gap-12 items-start ${i % 2 !== 0 ? 'md:direction-rtl' : ''}`}>
          <div class={i % 2 !== 0 ? 'md:order-2' : ''}>
            <h2 class="font-[var(--font-display)] text-[var(--text-3xl)] font-semibold text-[var(--color-paper)] overflow-wrap-anywhere">
              {section.title}
            </h2>
            <div class="h-[var(--rule-base)] bg-[var(--color-accent)] rounded-full my-4" style="width: 2.5rem" />
            <p class="text-[var(--color-ink-2)] leading-relaxed">{section.desc}</p>
          </div>
          <div class={`bg-[var(--color-paper-surface)] rounded-xl p-6 md:p-8 ${i % 2 !== 0 ? 'md:order-1' : ''}`}>
            <ul class="space-y-3">
              {section.items.map((item) => (
                <li class="flex items-center gap-3 text-[var(--color-ink-2)]">
                  <span class="w-6 h-6 bg-[var(--color-accent-soft)] rounded-full flex items-center justify-center flex-shrink-0">
                    <svg class="w-3 h-3 text-[var(--color-accent-3)]" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
