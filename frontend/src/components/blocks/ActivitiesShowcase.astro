---
import { ACTIVITIES_SECTIONS } from "../../lib/constants";
---

<section class="py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-16">
      {ACTIVITIES_SECTIONS.map((section) => (
        <div class="grid md:grid-cols-2 gap-8 items-start">
          <div>
            <h2 class="text-3xl font-heading font-bold text-navy-500 mb-4">{section.title}</h2>
            <div class="w-16 h-1 bg-gold-500 rounded-full mb-4" />
            <p class="text-gray-600 leading-relaxed">{section.desc}</p>
          </div>
          <div class="bg-navy-50 rounded-2xl p-8">
            <ul class="space-y-3">
              {section.items.map((item) => (
                <li class="flex items-center gap-3 text-gray-700">
                  <span class="w-6 h-6 bg-gold-500/20 rounded-full flex items-center justify-center flex-shrink-0">
                    <svg class="w-3 h-3 text-gold-600" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
