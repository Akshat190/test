---
import SectionTitle from "../ui/SectionTitle.astro";
import Button from "../ui/Button.astro";
import { getCelebrations, getImageUrl } from "../../lib/api";
import { formatDate } from "../../lib/utils";

interface Props {
  limit?: number;
}

const { limit = 6 } = Astro.props;
const { results: celebrations } = await getCelebrations();
const display = celebrations.slice(0, limit);
---

<section class="py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionTitle
      title="School Celebrations"
      subtitle="Celebrating festivals and special occasions that enrich our school culture"
    />

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {display.length > 0 ? display.map((celebration) => (
        <a href={`/gallery?category=${celebration.celebration_type}`} class="group block">
          <div class="bg-white rounded-2xl overflow-hidden shadow-soft hover:shadow-hover transition-all duration-300 hover:-translate-y-1">
            <div class="relative aspect-[16/10] overflow-hidden">
              <img
                src={getImageUrl(celebration.get_image_url) || '/placeholder.jpg'}
                alt={celebration.festivalname}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute top-4 left-4 bg-gold-500 text-navy-500 text-xs font-semibold px-3 py-1 rounded-full">
                {formatDate(celebration.date)}
              </div>
            </div>
            <div class="p-5">
              <h3 class="text-xl font-heading font-semibold text-navy-600 group-hover:text-gold-600 transition-colors">
                {celebration.festivalname}
              </h3>
            </div>
          </div>
        </a>
      )) : (
        <>
          {[
            { name: 'Diwali Celebration', date: '2024-11-15', type: 'festival' },
            { name: 'Republic Day', date: '2025-01-26', type: 'festival' },
            { name: 'Annual Day', date: '2024-12-10', type: 'event' },
          ].slice(0, limit).map((item) => (
            <a href={`/gallery?category=${item.type}`} class="group block">
              <div class="bg-white rounded-2xl overflow-hidden shadow-soft hover:shadow-hover transition-all duration-300 hover:-translate-y-1">
                <div class="relative aspect-[16/10] overflow-hidden bg-gray-200">
                  <div class="absolute inset-0 flex items-center justify-center text-gray-400">
                    <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div class="absolute top-4 left-4 bg-gold-500 text-navy-500 text-xs font-semibold px-3 py-1 rounded-full">
                    {formatDate(item.date)}
                  </div>
                </div>
                <div class="p-5">
                  <h3 class="text-xl font-heading font-semibold text-navy-600 group-hover:text-gold-600 transition-colors">
                    {item.name}
                  </h3>
                </div>
              </div>
            </a>
          ))}
        </>
      )}
    </div>

    <div class="text-center mt-10">
      <Button variant="outline" href="/gallery">
        View All Celebrations
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </Button>
    </div>
  </div>
</section>
