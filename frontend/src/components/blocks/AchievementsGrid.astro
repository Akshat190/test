---
import { ACHIEVEMENTS } from "../../lib/constants";
---

<section class="py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {ACHIEVEMENTS.map((a) => (
        <div class="p-6 bg-white rounded-2xl shadow-soft hover:shadow-hover transition-all duration-300 border-l-4 border-gold-500">
          <span class="text-xs text-gold-600 font-semibold uppercase tracking-wider">{a.year}</span>
          <h3 class="text-xl font-heading font-semibold text-navy-600 mt-1 mb-2">{a.title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{a.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
