---
import { cn } from "../../lib/utils";

interface Props {
  type?: string;
  label: string;
  name: string;
  required?: boolean;
  placeholder?: string;
  rows?: number;
  class?: string;
  error?: string;
}

const { type = "text", label, name, required = false, placeholder, rows, class: className, error } = Astro.props;
const id = `field-${name}`;
---

<div class={cn("space-y-1.5", className)}>
  <label for={id} class="block text-sm font-semibold text-navy-700">
    {label}
    {required && <span class="text-red-500 ml-0.5">*</span>}
  </label>
  {rows ? (
    <textarea
      id={id}
      name={name}
      rows={rows}
      placeholder={placeholder}
      required={required}
      class={cn(
        "w-full px-4 py-3 rounded-xl border-2 border-gray-200 bg-white text-gray-800 placeholder:text-gray-400",
        "focus:outline-none focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20",
        "transition-all duration-200 resize-none",
        error && "border-red-400 focus:border-red-500",
      )}
    ></textarea>
  ) : (
    <input
      id={id}
      type={type}
      name={name}
      placeholder={placeholder}
      required={required}
      class={cn(
        "w-full px-4 py-3 rounded-xl border-2 border-gray-200 bg-white text-gray-800 placeholder:text-gray-400",
        "focus:outline-none focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20",
        "transition-all duration-200",
        error && "border-red-400 focus:border-red-500",
      )}
    />
  )}
  {error && <p class="text-xs text-red-500 mt-1">{error}</p>}
</div>
