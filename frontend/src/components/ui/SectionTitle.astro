---
import { cn } from "../../lib/utils";

interface Props {
  title: string;
  subtitle?: string;
  centered?: boolean;
  light?: boolean;
  class?: string;
}

const { title, subtitle, centered = true, light = false, class: className } = Astro.props;
---

<div class={cn("max-w-3xl mx-auto mb-12 md:mb-16", centered && "text-center", className)}>
  <h2
    class={cn(
      "overflow-wrap-anywhere",
      light ? "text-[var(--color-ink-on-paper)]" : "text-[var(--color-paper)]",
    )}
  >
    {title}
  </h2>
  <div
    class={cn(
      "h-[var(--rule-base)] bg-[var(--color-accent)] rounded-full mt-3",
      centered ? "mx-auto" : "ml-0",
    )}
    style="width: 3rem"
  />
  {subtitle && (
    <p
      class={cn(
        "mt-4 text-base md:text-xl leading-relaxed max-w-2xl",
        centered && "mx-auto",
        light ? "text-[var(--color-ink-on-paper-2)]" : "text-[var(--color-ink-2)]",
      )}
    >
      {subtitle}
    </p>
  )}
</div>
