---
import { cn } from "../../lib/utils";

interface Props {
  title: string;
  subtitle?: string;
  centered?: boolean;
  light?: boolean;
  class?: string;
}

const { title, subtitle, centered = true, light = false, class: className } = Astro.props;
---

<div class={cn(centered && "text-center", "max-w-3xl mx-auto mb-12", className)}>
  <h2
    class={cn(
      "text-3xl md:text-4xl font-heading font-bold relative inline-block",
      light ? "text-white" : "text-navy-800",
    )}
  >
    {title}
    <span class="block h-1 bg-gold-500 rounded-full mt-3 mx-auto" style="width: 60px" />
  </h2>
  {subtitle && (
    <p class={cn("mt-4 text-lg leading-relaxed", light ? "text-gray-200" : "text-gray-600")}>
      {subtitle}
    </p>
  )}
</div>
