---
import { cva } from "class-variance-authority";
import { cn } from "../../lib/utils";

const card = cva(
  "bg-white rounded-2xl overflow-hidden transition-all duration-300",
  {
    variants: {
      variant: {
        default: "shadow-soft hover:shadow-card-hover",
        bordered: "border border-gray-100",
        flat: "shadow-none",
      },
      padding: {
        none: "",
        sm: "p-4",
        md: "p-6",
        lg: "p-8",
      },
    },
    defaultVariants: { variant: "default", padding: "md" },
  },
);

interface Props {
  variant?: "default" | "bordered" | "flat";
  padding?: "none" | "sm" | "md" | "lg";
  class?: string;
  as?: "div" | "article";
}

const { variant, padding, class: className, as: tag = "div" } = Astro.props;
const Tag = tag;
---

<Tag class={cn(card({ variant, padding }), className)}>
  <slot />
</Tag>
