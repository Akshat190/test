---
import { cva } from "class-variance-authority";
import { cn } from "../../lib/utils";

const button = cva(
  "inline-flex items-center justify-center gap-2 font-semibold rounded-full transition-[transform,box-shadow,background-color,border-color,color] duration-[var(--dur-base)] cursor-pointer border-0 no-underline text-center leading-tight overflow-wrap-anywhere",
  {
    variants: {
      variant: {
        primary:
          "bg-[var(--color-accent)] text-[var(--color-paper)] hover:bg-[var(--color-paper-raised)] hover:text-[var(--color-paper)] shadow-lg hover:shadow-xl hover:-translate-y-0.5",
        outline:
          "border-2 border-[var(--color-accent)] text-[var(--color-accent)] bg-transparent hover:bg-[var(--color-accent)] hover:text-[var(--color-paper)]",
        ghost:
          "text-[var(--color-accent)] bg-transparent hover:bg-[var(--color-accent-soft)]",
        white:
          "bg-[var(--color-paper-raised)] text-[var(--color-paper)] hover:bg-[var(--color-accent)] hover:text-[var(--color-paper)] shadow-md",
      },
      size: {
        sm: "px-4 py-2 text-xs",
        md: "px-6 py-3 text-sm",
        lg: "px-8 py-4 text-base",
      },
    },
    defaultVariants: { variant: "primary", size: "md" },
  },
);

interface Props {
  variant?: "primary" | "outline" | "ghost" | "white";
  size?: "sm" | "md" | "lg";
  href?: string;
  class?: string;
  target?: string;
  rel?: string;
}

const { variant, size, href, class: className, target, rel, ...attrs } = Astro.props;
const classes = cn(button({ variant, size }), className);
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel} {...attrs}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...attrs}>
      <slot />
    </button>
  )
}
