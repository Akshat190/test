---
import { NAV_ITEMS } from "../../lib/constants";

export interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const isActive = (path: string) => currentPath === path || currentPath.startsWith(path + "/");
---

<header class="sticky top-0 z-50">
  <nav class="bg-gradient-to-r from-navy-500 to-navy-700 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20 lg:h-28">
        <a href="/" class="flex-shrink-0">
          <img
            src="/logo.svg"
            alt="Kapadia High School"
            class="h-16 lg:h-20 w-auto transition-transform duration-300 hover:scale-105"
            oncontextmenu="return false"
          />
        </a>

        <div class="hidden lg:flex lg:items-center lg:gap-1">
          {NAV_ITEMS.map((item) => (
            item.children ? (
              <div class="relative group">
                <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-white/90 hover:text-gold-500 transition-colors duration-200">
                  {item.label}
                  <svg class="w-3 h-3 mt-0.5 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <div class="absolute top-full left-0 mt-1 w-56 bg-white rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-2 group-hover:translate-y-0 py-2 z-50">
                  {item.children.map((child) => (
                    <a
                      href={child.path}
                      class="block px-5 py-2.5 text-sm text-gray-700 hover:text-gold-600 hover:bg-gold-50 transition-all duration-200 border-l-2 border-transparent hover:border-gold-500"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={item.path}
                class={`px-3 py-2 text-sm font-medium transition-colors duration-200 ${isActive(item.path) ? "text-gold-500" : "text-white/90 hover:text-gold-500"}`}
              >
                {item.label}
              </a>
            )
          ))}

          <a
            href="https://forms.gle/sDftg7osPaxvGKAD8"
            target="_blank"
            class="ml-4 inline-flex items-center gap-2 px-5 py-2.5 bg-gold-500 text-navy-500 font-semibold text-sm rounded-full hover:bg-white transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-0.5"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 7l-9-5 9-5 9 5-9 5z" />
            </svg>
            Admission Open
          </a>
        </div>

        <button id="mobile-menu-btn" class="lg:hidden p-2 text-white hover:text-gold-500 transition-colors" aria-label="Toggle navigation">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="lg:hidden hidden bg-navy-600 rounded-b-2xl shadow-2xl px-4 pb-4 pt-2">
      {NAV_ITEMS.map((item) => (
        item.children ? (
          <div class="mb-1">
            <button class="mobile-dropdown-toggle flex items-center justify-between w-full px-3 py-2.5 text-sm font-medium text-white/90 hover:text-gold-500 transition-colors rounded-lg">
              {item.label}
              <svg class="w-3 h-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="mobile-dropdown hidden pl-4 mt-1 mb-2 space-y-1">
              {item.children.map((child) => (
                <a
                  href={child.path}
                  class="block px-3 py-2 text-sm text-gray-300 hover:text-gold-500 hover:bg-navy-500/50 rounded-lg transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.path}
            class={`block px-3 py-2.5 text-sm font-medium rounded-lg transition-colors ${isActive(item.path) ? "text-gold-500 bg-navy-700" : "text-white/90 hover:text-gold-500 hover:bg-navy-500/50"}`}
          >
            {item.label}
          </a>
        )
      ))}
      <a
        href="https://forms.gle/sDftg7osPaxvGKAD8"
        target="_blank"
        class="mt-3 block text-center px-5 py-3 bg-gold-500 text-navy-500 font-semibold text-sm rounded-full hover:bg-gold-400 transition-colors"
      >
        <svg class="w-4 h-4 inline mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 7l-9-5 9-5 9 5-9 5z" />
        </svg>
        Admission Open
      </a>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    menuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });

    document.querySelectorAll('.mobile-dropdown-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dropdown = btn.nextElementSibling;
        const icon = btn.querySelector('svg');
        dropdown?.classList.toggle('hidden');
        if (icon) {
          icon.style.transform = dropdown?.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
        }
      });
    });
  });
</script>
