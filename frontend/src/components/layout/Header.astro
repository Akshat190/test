---
import { NAV_ITEMS } from "../../lib/constants";

export interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const isActive = (path: string) => currentPath === path || currentPath.startsWith(path + "/");
---

<header class="sticky top-0 z-50">
  <nav class="paper-dark bg-[var(--color-paper)] shadow-lg" aria-label="Main navigation">
    <div class="hallmark-container">
      <div class="flex items-center justify-between h-20 lg:h-28">
        <a href="/" class="flex-shrink-0 focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-4 rounded-sm" aria-label="Kapadia High School home">
          <img
            src="/logo.svg"
            alt=""
            class="h-16 lg:h-20 w-auto transition-transform duration-[var(--dur-fast)] hover:scale-[1.03]"
            oncontextmenu="return false"
          />
        </a>

        <div class="hidden lg:flex lg:items-center lg:gap-1">
          {NAV_ITEMS.map((item) => (
            item.children ? (
              <div class="relative group">
                <button
                  class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-[var(--color-ink-on-paper)]/90 hover:text-[var(--color-accent)] transition-colors duration-[var(--dur-fast)] rounded-md focus-visible:outline-2 focus-visible:outline-[var(--color-accent)]"
                  aria-expanded="false"
                >
                  {item.label}
                  <svg class="w-3 h-3 mt-0.5 transition-transform duration-[var(--dur-base)] group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <div class="absolute top-full left-0 mt-1 w-56 bg-[var(--color-paper-raised)] rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-[opacity,visibility,transform] duration-[var(--dur-base)] translate-y-2 group-hover:translate-y-0 py-2 z-50">
                  {item.children.map((child) => (
                    <a
                      href={child.path}
                      class="block px-5 py-2.5 text-sm text-[var(--color-ink-2)] hover:text-[var(--color-accent-3)] hover:bg-[var(--color-accent-soft)] transition-[color,background-color,border-color] duration-[var(--dur-fast)] border-l-2 border-transparent hover:border-[var(--color-accent)]"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={item.path}
                class={`px-3 py-2 text-sm font-medium transition-colors duration-[var(--dur-fast)] rounded-md ${isActive(item.path) ? "text-[var(--color-accent)]" : "text-[var(--color-ink-on-paper)]/90 hover:text-[var(--color-accent)]"}`}
              >
                {item.label}
              </a>
            )
          ))}

          <a
            href="https://forms.gle/sDftg7osPaxvGKAD8"
            target="_blank"
            rel="noopener"
            class="ml-4 inline-flex items-center gap-2 px-5 py-2.5 bg-[var(--color-accent)] text-[var(--color-paper)] font-semibold text-sm rounded-full hover:bg-[var(--color-paper-raised)] hover:text-[var(--color-paper)] transition-[background-color,color,box-shadow,transform] duration-[var(--dur-base)] shadow-lg hover:shadow-xl hover:-translate-y-0.5"
          >
            Admission Open
          </a>
        </div>

        <button id="mobile-menu-btn" class="lg:hidden p-2 text-[var(--color-ink-on-paper)]/90 hover:text-[var(--color-accent)] transition-colors rounded-md" aria-label="Toggle navigation" aria-expanded="false">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="lg:hidden hidden paper-dark bg-[var(--color-paper-2)] rounded-b-2xl shadow-2xl px-4 pb-4 pt-2" aria-label="Mobile navigation">
      {NAV_ITEMS.map((item) => (
        item.children ? (
          <div class="mb-1">
            <button class="mobile-dropdown-toggle flex items-center justify-between w-full px-3 py-2.5 text-sm font-medium text-[var(--color-ink-on-paper)]/90 hover:text-[var(--color-accent)] transition-colors rounded-lg">
              {item.label}
              <svg class="w-3 h-3 transition-transform duration-[var(--dur-fast)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="mobile-dropdown hidden pl-4 mt-1 mb-2 space-y-1">
              {item.children.map((child) => (
                <a
                  href={child.path}
                  class="block px-3 py-2 text-sm text-[var(--color-ink-on-paper-2)] hover:text-[var(--color-accent)] hover:bg-[var(--color-paper-3)]/50 rounded-lg transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.path}
            class={`block px-3 py-2.5 text-sm font-medium rounded-lg transition-colors ${isActive(item.path) ? "text-[var(--color-accent)] bg-[var(--color-paper-3)]" : "text-[var(--color-ink-on-paper)]/90 hover:text-[var(--color-accent)] hover:bg-[var(--color-paper-3)]/50"}`}
          >
            {item.label}
          </a>
        )
      ))}
      <a
        href="https://forms.gle/sDftg7osPaxvGKAD8"
        target="_blank"
        rel="noopener"
        class="mt-3 block text-center px-5 py-3 bg-[var(--color-accent)] text-[var(--color-paper)] font-semibold text-sm rounded-full hover:bg-[var(--color-accent-2)] transition-colors"
      >
        Admission Open
      </a>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    menuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });

    document.querySelectorAll('.mobile-dropdown-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dropdown = btn.nextElementSibling;
        const icon = btn.querySelector('svg');
        dropdown?.classList.toggle('hidden');
        if (icon) {
          icon.style.transform = dropdown?.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
        }
      });
    });
  });
</script>
