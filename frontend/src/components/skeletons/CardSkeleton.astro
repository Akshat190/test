---
import Skeleton from "../ui/Skeleton.astro";

interface Props {
  hasImage?: boolean;
  hasBadge?: boolean;
  lines?: number;
}

const { hasImage = true, hasBadge = true, lines = 2 } = Astro.props;
---

<div class="bg-white rounded-2xl overflow-hidden shadow-soft">
  {hasImage && <Skeleton variant="rectangular" class="aspect-[4/3] w-full rounded-none" />}
  <div class="p-5 space-y-3">
    {hasBadge && <Skeleton class="h-4 w-20 rounded-full" />}
    {Array.from({ length: lines }).map(() => (
      <Skeleton class={`h-5 ${Math.random() > 0.5 ? 'w-3/4' : 'w-1/2'}`} />
    ))}
    <Skeleton class="h-4 w-16" />
  </div>
</div>
