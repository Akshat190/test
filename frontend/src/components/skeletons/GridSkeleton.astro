---
import CardSkeleton from "./CardSkeleton.astro";

interface Props {
  count?: number;
  columns?: 2 | 3 | 4;
  hasImage?: boolean;
  hasBadge?: boolean;
  lines?: number;
}

const { count = 3, columns = 3, hasImage = true, hasBadge = true, lines = 2 } = Astro.props;

const gridCols: Record<number, string> = {
  2: "md:grid-cols-2",
  3: "md:grid-cols-2 lg:grid-cols-3",
  4: "md:grid-cols-2 lg:grid-cols-4",
};
---

<div class={`grid ${gridCols[columns] || gridCols[3]} gap-8`}>
  {Array.from({ length: count }).map(() => (
    <CardSkeleton hasImage={hasImage} hasBadge={hasBadge} lines={lines} />
  ))}
</div>
