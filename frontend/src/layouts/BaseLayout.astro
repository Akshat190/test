---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ScrollToTop from '../components/layout/ScrollToTop.astro';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  carousel?: boolean;
}

const { title, description, keywords, ogImage, ogType, canonical, carousel } = Astro.props;
const siteTitle = title ? `${title} | Kapadia High School` : 'Kapadia High School';
const siteDesc = description || 'Excellence in Education Since 1956. A co-educational English medium school in Gujarat, India.';
const siteUrl = 'https://kapadiahighschool.com';
const pageUrl = canonical ? `${siteUrl}${canonical}` : siteUrl;
const pageOgType = ogType || 'website';
const pageOgImage = ogImage || `${siteUrl}/og-image.jpg`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDesc} />
    <meta name="keywords" content={keywords || 'Kapadia High School, CBSE School, GSEB School, Gujarat, Education, Best School'} />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="theme-color" content="#003264" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={pageOgType} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Kapadia High School" />
    <meta property="og:image" content={pageOgImage} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDesc} />
    <meta name="twitter:image" content={pageOgImage} />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={`
      {
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        "name": "Kapadia High School",
        "alternateName": "KHS",
        "description": "Excellence in Education Since 1956",
        "url": "https://kapadiahighschool.com",
        "foundingDate": "1956",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Near Chhatral Railway Station",
          "addressLocality": "Kalol",
          "addressRegion": "Gujarat",
          "postalCode": "382721",
          "addressCountry": "IN"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+91-6354368335",
          "contactType": "admissions",
          "email": "info@kapadiahighschool.com"
        }
      }
    `} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body class="flex flex-col min-h-screen">
    <ScrollToTop />
    <Header />

    {
      carousel && (
        <div>
          <slot name="carousel" />
        </div>
      )
    }

    <main class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
